# Optional local file for secrets and RPC endpoints. Never commit .env.
# Collection settings live in launch.json (the same for the testnet rehearsal and mainnet).

# Deploy key. Prefer setting PRIVATE_KEY in the environment for the one deploy
# session and removing it afterwards; a fresh wallet that only pays for gas is best.
PRIVATE_KEY=

# Optional RPC overrides (public endpoints are used otherwise)
ARBITRUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=
ARBITRUM_RPC_URL=
ETHEREUM_RPC_URL=

# Optional: Etherscan API v2 key, enables source verification on deploy.
# Leave it empty for the private testnet rehearsal: verified source would publish the art.
ETHERSCAN_API_KEY=
