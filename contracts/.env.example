# Copy to .env and fill in. Never commit .env.

# Deployer / admin key (a fresh wallet funded with testnet ETH is best)
PRIVATE_KEY=

# Optional RPC overrides (public endpoints are used otherwise)
ARBITRUM_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

# Optional: Etherscan API v2 key, enables automatic source verification on deploy
ETHERSCAN_API_KEY=

# Collection settings used by scripts/deploy.ts
COLLECTION_NAME=FheCat
COLLECTION_SYMBOL=FCAT
MAX_SUPPLY=4444
# Final owner (Ownable2Step: that address must call acceptOwnership). Defaults to the deployer.
OWNER_ADDRESS=
ROYALTY_RECEIVER=
ROYALTY_BPS=500
PUBLIC_PRICE_ETH=0
ALLOWLIST_PRICE_ETH=0
MAX_PER_WALLET=3
ALLOWLIST_MAX_PER_WALLET=2
# true = open the public sale right after deploying
OPEN_SALE=false
