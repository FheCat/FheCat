{
  "name": "fhecat-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "FheCat: pixel cats with encrypted DNA on Fhenix CoFHE",
  "license": "MIT",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:fork": "COFHE_SKIP_MOCKS_DEPLOY=1 FORK=${FORK:-arb-sepolia} hardhat test test/fork/FheCat.fork.test.ts",
    "art:sol": "ts-node scripts/gen-art-sol.ts",
    "art:preview": "ts-node scripts/preview-art.ts",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:arb-sepolia": "hardhat run scripts/deploy.ts --network arb-sepolia",
    "deploy:base-sepolia": "hardhat run scripts/deploy.ts --network base-sepolia",
    "deploy:eth-sepolia": "hardhat run scripts/deploy.ts --network eth-sepolia",
    "deploy:arbitrum": "hardhat run scripts/deploy.ts --network arbitrum",
    "deploy:ethereum": "hardhat run scripts/deploy.ts --network ethereum",
    "export:abi": "ts-node scripts/export-abi.ts"
  },
  "devDependencies": {
    "@cofhe/hardhat-plugin": "1.0.1",
    "@cofhe/sdk": "1.0.1",
    "@fhenixprotocol/cofhe-contracts": "1.0.1",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@openzeppelin/merkle-tree": "^1.0.8",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.15.0",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "~5.9.3"
  }
}
