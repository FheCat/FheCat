{
  "name": "fhecat-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:admin-copy": "node scripts/build-admin-copy.mjs",
    "build:testnet-copy": "node scripts/build-admin-copy.mjs --public",
    "build:admin-game": "node scripts/build-admin-game.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@cofhe/sdk": "1.0.1",
    "@openzeppelin/merkle-tree": "^1.0.8",
