    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.12",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.1"
  },
  "overrides": {
    "viem": "$viem",
    "uuid": "^11.1.1"
